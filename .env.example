# Atlas Dental Agent — Environment Variables
# Copy to .env and fill in. Never commit the real .env file.

# ---- LLM ----
ANTHROPIC_API_KEY=

# ---- Supabase (Postgres now; same project can add pgvector later) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Service role key bypasses RLS -- backend-only, never expose client-side.
SUPABASE_ANON_KEY=
# Only needed if the receptionist Web App talks to Supabase directly from
# the browser for non-sensitive reads; otherwise route everything through
# your own backend using the service role key.

# ---- Google Cloud project (shared by Gmail SMTP + Calendar API) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# If the clinic uses Google Workspace and you'd rather not manage a refresh
# token, use a service account with domain-wide delegation instead:
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ---- Gmail SMTP specifics ----
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SENDER_ADDRESS=

# ---- Google Calendar ----
GOOGLE_CALENDAR_ID=
# If there's more than one provider/dentist, map provider_id -> calendar_id:
GOOGLE_CALENDAR_PROVIDER_MAP={}

# ---- Clinic configuration (not secrets, but config the build needs) ----
CLINIC_EMERGENCY_ALERT_EMAIL=
CLINIC_FRONT_DESK_BCC_EMAIL=
CLINIC_BUSINESS_HOURS_TZ=America/Toronto

# ---- Deferred — not needed for this build phase ----
# OPENAI_API_KEY=          # only when/if the vector DB phase (atlas_dental_vector_db_design.md) starts
# VOICE_PROVIDER_API_KEY=  # only when the voice channel is built

# ---- Public demo access gate (app.py) ----
# If set, patients must enter this code before the chat UI loads. Leave blank
# to disable the gate entirely (e.g. for local dev).
APP_ACCESS_PASSPHRASE=
